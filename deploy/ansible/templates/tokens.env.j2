# /opt/m4l-telemetry/tokens.env  --  managed by Ansible, re-rendered on every run.
#
# Rotate by updating api_ingest_tokens in group_vars/all.yml and running:
#   ansible-playbook -i inventory.yml playbook.yml --tags app
#
# The API picks up the change when the container is recreated (the Ansible
# handler does this automatically when this file changes).

TELEMETRY_INGEST_TOKENS={{ api_ingest_tokens }}
