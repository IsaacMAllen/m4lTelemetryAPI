# /opt/m4l-telemetry/secrets.env  --  rendered ONCE by Ansible, never overwritten.
#
# Contains credentials that must never change without deliberate action:
# the Postgres password (would require a pg_dumpall + restore to rotate),
# the Restic encryption password (lose this and backups are gone forever),
# and the Backblaze keys.
#
# To rotate POSTGRES_PASSWORD:
#   1. Take a fresh backup first: sudo /usr/local/bin/m4l-telemetry-backup
#   2. Edit this file: sudo nano /opt/m4l-telemetry/secrets.env
#   3. Change POSTGRES_PASSWORD to a new value.
#   4. Connect to Postgres and run:
#        ALTER USER telemetry WITH PASSWORD '<new-value>';
#   5. docker compose up -d

POSTGRES_PASSWORD={{ lookup('password', '/dev/null length=48 chars=ascii_letters,digits') }}

# --- Backups (Backblaze B2 via restic) ---
# Fill these in after first deploy.  Get them at:
#   https://secure.backblaze.com/app_keys.htm
RESTIC_REPOSITORY=b2:{{ backup_bucket | default('FILL_ME_IN') }}:m4l-telemetry
RESTIC_PASSWORD={{ lookup('password', '/dev/null length=48 chars=ascii_letters,digits') }}
B2_ACCOUNT_ID=FILL_ME_IN
B2_ACCOUNT_KEY=FILL_ME_IN
