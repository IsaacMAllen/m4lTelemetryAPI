# /opt/m4l-telemetry/.env  --  rendered ONCE by Ansible, then never touched.
#
# Re-running the playbook will NOT overwrite this file.  To rotate any
# secret, edit it on the box, then `docker compose up -d` to restart.
#
# `openssl rand -hex 32` was used to generate the placeholders below.

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD={{ lookup('password', '/dev/null length=48 chars=ascii_letters,digits') }}

# --- API ingest auth (comma-separated bearer tokens) ------------------------
# Use a unique token per "fleet" or per release channel.  Rotate by editing
# this file and `docker compose up -d`.
TELEMETRY_INGEST_TOKENS={{ lookup('password', '/dev/null length=48 chars=ascii_letters,digits') }}

# --- Backups (Backblaze B2) -------------------------------------------------
# Fill these in BEFORE enabling backups.  Get them at:
#   https://secure.backblaze.com/app_keys.htm
RESTIC_REPOSITORY=b2:{{ backup_bucket | default('FILL_ME_IN') }}:m4l-telemetry
RESTIC_PASSWORD={{ lookup('password', '/dev/null length=48 chars=ascii_letters,digits') }}
B2_ACCOUNT_ID=FILL_ME_IN
B2_ACCOUNT_KEY=FILL_ME_IN
