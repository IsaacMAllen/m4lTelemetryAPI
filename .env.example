# Copy to .env (or set in your shell / Kubernetes Secret) before running.

# ---- Database --------------------------------------------------------------
# DSN for the shared cluster Postgres. Use the asyncpg driver.
# Example: postgresql+asyncpg://user:pass@postgres.shared.svc.cluster.local:5432/telemetry
TELEMETRY_DATABASE_URL=postgresql+asyncpg://telemetry:telemetry@localhost:5432/telemetry

# ---- Auth -------------------------------------------------------------------
# Comma-separated list of bearer tokens that may POST to /v1/events. If empty
# the API accepts unauthenticated POSTs (NOT recommended for prod).
TELEMETRY_INGEST_TOKENS=

# ---- Server -----------------------------------------------------------------
TELEMETRY_LOG_LEVEL=INFO
# Max accepted ndjson body size in bytes. bz.telemetry batches 32 events by
# default, so 4 MB easily fits even pathological payloads.
TELEMETRY_MAX_BODY_BYTES=4194304
# Maximum events accepted per POST. Anything past this is rejected with 413.
TELEMETRY_MAX_EVENTS_PER_REQUEST=1000

# ---- CORS (optional) --------------------------------------------------------
# Comma-separated origins. Leave blank to disable CORS entirely (the typical
# case — bz.telemetry is a desktop client, not a browser).
TELEMETRY_CORS_ORIGINS=
